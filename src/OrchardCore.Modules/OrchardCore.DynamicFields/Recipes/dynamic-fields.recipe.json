                      "At": 1,
                      "IsModule": false,
                      "IsInline": false,
                      "IsDeferred": false,
                      "IsAsync": false
                    },
                    {
                      "Type": 0,
                      "Src": "(function () {\r\n    const {\r\n        getValue, \r\n        setValue, \r\n        addEventListener, \r\n        querySelector\r\n    } = window.dynamicFields.DynamicFieldsExamples_GrapesJs_Value;\r\n\r\n    const editor = querySelector(\u0027grapesjs-editor\u0027);\r\n    editor.onChange = function (object) {\r\n        setValue(object);\r\n    };\r\n    addEventListener(\u0027value\u0027, (object) =\u003E {\r\n        if (object) {\r\n            editor.loadHtmlCss(object);\r\n        }\r\n    }, {init: true});\r\n})();",
                      "At": 1,
