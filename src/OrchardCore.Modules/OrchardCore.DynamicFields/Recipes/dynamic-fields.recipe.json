                  "Code": "\u003Cgrapesjs-editor\u003E\u003C/grapesjs-editor\u003E",
                  "Resources": [
                    {
                      "Type": 0,
                      "Src": "/* grapesjs-editor isn\u0027t encapsulated, and autoReplaceSvg will break editor */\r\nwindow.FontAwesomeConfig = { autoReplaceSvg: \u0027nest\u0027 };",
                      "At": 2,
                      "IsModule": false,
                      "IsInline": true,
                      "IsDeferred": false,
                      "IsAsync": false
                    },
                    {
                      "Type": 1,
                      "Src": "https://unpkg.com/grapesjs@0.22.12/dist/css/grapes.min.css",
                      "At": 1,
                      "IsModule": false,
                      "IsInline": false,
                      "IsDeferred": false,
                      "IsAsync": false
                    },
                    {
                      "Type": 0,
                      "Src": "https://unpkg.com/grapesjs@0.22.12/dist/grapes.min.js",
                      "At": 1,
                      "IsModule": false,
                      "IsInline": false,
                      "IsDeferred": false,
                      "IsAsync": false
                    },
                    {
                      "Type": 0,
