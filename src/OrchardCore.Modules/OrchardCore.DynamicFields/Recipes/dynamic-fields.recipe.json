                    {
                      "Type": 0,
                      "Src": "(function () {\r\n    /* available functions */\r\n    const {\r\n        getValue, \r\n        setValue, \r\n        addEventListener, \r\n        querySelector\r\n    } = window.dynamicFields.DynamicFieldsExamples_SimpleImageGallery_Value;\r\n\r\n    const gallery = querySelector(\u0027simple-image-gallery\u0027);\r\n    gallery.onChange = (object) =\u003E {\r\n        setValue(object);\r\n    };\r\n\r\n    addEventListener(\u0027value\u0027, (object) =\u003E {\r\n        if (object?.src) {\r\n            gallery.setImage(object?.src);\r\n        }\r\n    }, {init: true});\r\n})();",
                      "At": 1,
                      "IsModule": false,
                      "IsInline": true,
                      "IsDeferred": false,
                      "IsAsync": false
                    }
                  ]
