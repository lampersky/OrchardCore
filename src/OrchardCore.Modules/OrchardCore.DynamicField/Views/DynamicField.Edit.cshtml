@model OrchardCore.DynamicField.ViewModels.EditDynamicFieldViewModel
@using OrchardCore.DynamicField.Settings
@using OrchardCore.Mvc.Utilities
@{
    var settings = Model.PartFieldDefinition.GetSettings<DynamicFieldSettings>();
    var culture = await Orchard.GetContentCultureAsync(Model.Field.ContentItem);
}

<div class="@Orchard.GetFieldWrapperClasses(Model.PartFieldDefinition)" id="@Html.IdFor(x => x.Value)_FieldWrapper">
    <label asp-for="Value" class="@Orchard.GetLabelClasses(inputRequired: false)">@Model.PartFieldDefinition.DisplayName()</label>
    <div class="@Orchard.GetEndClasses()">
        <span asp-validation-for="Value"></span>
        <parent-component asp-for="Value">
            @Html.Raw(settings.Code)
        </parent-component>
    </div>
</div>

<script at="Foot" asp-src="~/OrchardCore.DynamicField/Scripts/parent-component.js"></script>

@if (!string.IsNullOrEmpty(settings.InlineScript))
{
    <script at="Foot">
        @Html.Raw(settings.InlineScript)
    </script>
}

@if (!string.IsNullOrEmpty(settings.InlineStyle))
{
    <style at="Head">
        @Html.Raw(settings.InlineStyle)
    </style>
}
