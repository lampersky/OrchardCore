@using OrchardCore.ContentManagement.Metadata
@using OrchardCore.DynamicField.Extensions
@using OrchardCore.DynamicField.Settings
@using OrchardCore.ResourceManagement
@model OrchardCore.DynamicField.Settings.DynamicFieldSettings
@inject IContentDefinitionManager ContentDefinitionManager

@{
    var searchUrl = Url.RouteUrl(new { area = "OrchardCore.DynamicField", controller = "DynamicFieldsAdmin", action = "SearchDynamicFields" });

    var items = await ContentDefinitionManager.ListContentTypesWithFieldsNamesOfTypeAsync<OrchardCore.DynamicField.Fields.DynamicField>();

}

@if (Context.Request.Query.ContainsKey("contentType") && Context.Request.Query.ContainsKey("contentField"))
{
    <div class="alert alert-warning alert-dismissible fade show" role="alert">
        @T["The DynamicField configuration was copied from the '{1}' field of the '{0}' content type. Don't forget to save your changes.", Context.Request.Query["contentType"], Context.Request.Query["contentField"]]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="@T["Close"]"></button>
    </div>
}

<button type="button" class="btn btn-sm btn-outline-primary" data-bs-toggle="modal" data-bs-target="#contentTypesWithDynamicFieldsModal">
    @T["Copy"]
</button>
<div class="modal fade" id="contentTypesWithDynamicFieldsModal" tabindex="-1" aria-labelledby="contentTypesWithDynamicFieldsModalTitle">
    <div class="modal-dialog modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h1 class="modal-title fs-5" id="contentTypesWithDynamicFieldsModalTitle">@T["Copy existing configuration"]</h1>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="@T["Close"]"></button>
            </div>
            <div class="modal-body">
                <div class="alert alert-danger" role="alert">
                    @T["If you have already configured the dynamic field, your changes will be lost!"]
                </div>
                <div>@T["Choose the field configuration you want to copy from:"]</div>
                <div class="d-flex flex-column gap-6">
                    @foreach (var item in items)
                    {
                        @foreach (var fieldName in item.Value)
                        {
                            <a href="?contentType=@(item.Key)&contentField=@(fieldName)">@(item.Key).@(fieldName)</a>
                        }
                    }
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">@T["Close"]</button>
            </div>
        </div>
    </div>
</div>

<div class="mb-3">
    <div class="w-md-75 w-xl-50 pe-md-3">
        <label asp-for="Code" class="form-label">@T["Code"]</label>
        <textarea asp-for="Code" rows="2" class="form-control"></textarea>
    </div>
    <span class="hint">@T["The component code."]</span>
</div>

@{
    /* variable name Capitalized intentionally */
    var Resources = new[] { new Resource() };
}

<template id="resource-template">
    @Html.EditorFor(_ => Resources)
</template>

<div class="mb-3">
    <label class="form-label">@T["Resources"] <a onclick="addResource()"><i class="fa fa-plus-circle" aria-hidden="true"></i></a></label>
    <div class="resources">
        @Html.EditorFor(m => m.Resources)
    </div>
</div>

<style asp-name="dynamic-fields" at="Head" asp-src="~/OrchardCore.DynamicField/Styles/dynamic-fields.css"></style>
<script asp-name="dynamic-fields" at="Foot" asp-src="~/OrchardCore.DynamicField/Scripts/dynamic-fields.js"></script>
