@using OrchardCore.DynamicField.Settings
@using OrchardCore.ResourceManagement
@model OrchardCore.DynamicField.Settings.Resource


@{
}

<div class="input-group mb-3 resource">
    <select class="form-select auto-width" asp-for="Type">
        <option value="@ResourceType.Script" selected>Script</option>
        <option value="@ResourceType.Style">Style</option>
    </select>

    <select class="form-select auto-width" asp-for="At">
        <option value="@ResourceLocation.Foot" selected>Foot</option>
        <option value="@ResourceLocation.Head">Head</option>
    </select>

    <select class="form-select auto-width" asp-for="IsModule">
        <option value="@Boolean.FalseString" selected>Non-module</option>
        <option value="@Boolean.TrueString">Module</option>
    </select>

    <select class="form-select auto-width" asp-for="IsInline" disabled>
        <option value="@Boolean.FalseString" selected>External</option>
        <option value="@Boolean.TrueString">Inline</option>
    </select>

    @*      
        <div class="input-group-text">
            <div class="form-check">
                <input class="form-check-input" type="checkbox" asp-for="@Model.IsModule">
                <label class="form-check-label" asp-for="@Model.Resources[i].IsModule">
                    Module
                </label>
            </div>
        </div>

        <div class="input-group-text">
            <div class="form-check">
                <input class="form-check-input" type="checkbox" asp-for="@Model.IsInline" disabled>
                <label class="form-check-label" asp-for="@Model.Resources[i].IsInline">
                    Inline
                </label>
            </div>
        </div> 
*@

    <input type="text" class="form-control" aria-label="Resource Url" asp-for="Src">

    <div class="input-group-text">
        <button class="btn btn-outline-secondary btn-sm up" type="button" onclick="move(this, -1)"><i class="fa-solid fa-up-long"></i></button>
        <button class="btn btn-outline-secondary btn-sm down" type="button" onclick="move(this, 1)"><i class="fa-solid fa-down-long"></i></button>
        <button class="btn btn-outline-secondary btn-sm remove" type="button" onclick="removeResource(this)"><i class="fa-solid fa-trash"></i></button>
        <button class="btn btn-outline-secondary btn-sm add" type="button" onclick="addResource()"><i class="fa-solid fa-plus"></i></button>
    </div>
</div>